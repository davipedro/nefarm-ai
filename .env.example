# API Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-in-production
API_DEBUG=True

# LLM API Keys
# Escolha UMA das opções abaixo para cada componente:

# Para browser-use MCP (RECOMENDADO: browser-use credits com $10 grátis)
BROWSER_USE_API_KEY=buse_your_key_here

# Para Main MCP (orquestração) - Escolha uma opção:
ANTHROPIC_API_KEY=sk-ant-your_key_here
# ou
GOOGLE_API_KEY=AIza_your_key_here
# ou
OPENAI_API_KEY=sk-your_key_here

# IA Local MCP Configuration
MODEL_NAME=distilbert-base-uncased
MODEL_CACHE_DIR=./src/ia_local_mcp/models
CLASSIFICATION_THRESHOLD=0.7
IA_LOCAL_MCP_PORT=8001
IA_LOCAL_MCP_HOST=localhost

# PMC Extractor Configuration
PMC_BASE_URL=https://www.ncbi.nlm.nih.gov/pmc/articles/
PMC_CDN_URL=https://cdn.ncbi.nlm.nih.gov/pmc/blobs/
PMC_RATE_LIMIT_DELAY=1.0

# Browser Use MCP Configuration
WEBPLOTDIGITIZER_URL=https://web.eecs.utk.edu/~dcostine/personal/PowerDeviceLib/DigiTest/index.html
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=120

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/nefarm.log

# CORS (para desenvolvimento)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MCP Transport Configuration
MCP_TRANSPORT=stdio  # stdio ou sse
