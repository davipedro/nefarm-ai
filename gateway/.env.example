# ==============================================
# NEFARM-AI API GATEWAY - Configurações
# ==============================================

# ----- Servidor -----
# Porta em que o Gateway vai escutar
PORT=8080

# Ambiente (development, production)
NODE_ENV=development

# ----- MCP Client -----
# URL do MCP Client (orquestrador)
MCP_CLIENT_URL=http://localhost:3000

# Timeout para requisições ao MCP Client (em ms)
MCP_CLIENT_TIMEOUT=30000

# ----- Segurança - Rate Limiting -----
# Limite de requisições por minuto para usuários autenticados
RATE_LIMIT_AUTHENTICATED=100

# Limite de requisições por minuto para não autenticados
RATE_LIMIT_UNAUTHENTICATED=20

# Tempo da janela de rate limiting (em minutos)
RATE_LIMIT_WINDOW_MIN=1

# ----- Segurança - CORS -----
# Origens permitidas (separadas por vírgula)
# Exemplo: http://localhost:3001,https://nefarm-ai.com
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ----- Segurança - Payload -----
# Tamanho máximo de payload em MB
MAX_PAYLOAD_SIZE_MB=10

# ----- HTTPS/TLS (Nível 3) -----
# Habilitar HTTPS (true/false)
ENABLE_HTTPS=false

# Caminho para o certificado SSL
SSL_CERT_PATH=./certs/cert.pem

# Caminho para a chave SSL
SSL_KEY_PATH=./certs/key.pem

# ----- Circuit Breaker -----
# Timeout do circuit breaker (em ms)
CIRCUIT_BREAKER_TIMEOUT=10000

# Número de falhas antes de abrir o circuito
CIRCUIT_BREAKER_ERROR_THRESHOLD=50

# Tempo que o circuito fica aberto (em ms)
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ----- Logging -----
# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# ----- Prompt Injection Detection (Nível 4) -----
# Habilitar detecção de prompt injection (true/false)
ENABLE_PROMPT_INJECTION_DETECTION=true

# Limite de requisições para IA por minuto
AI_RATE_LIMIT=5
